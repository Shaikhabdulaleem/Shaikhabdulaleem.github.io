PORT=3000
NODE_ENV=production
# Used only by the optional Docker/Express deployment. Set it to that site's exact HTTPS origin.
PUBLIC_ORIGIN=https://shaikhabdulaleem.github.io
RATE_LIMIT_PER_MINUTE=30
MAX_JSON_SIZE=32kb

# Ollama is optional. GitHub Pages always uses the deterministic assistant.
OLLAMA_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TIMEOUT_MS=3000
OLLAMA_RETRY_DELAY_MS=60000
