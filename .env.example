PORT=3000
NODE_ENV=production
PUBLIC_ORIGIN=https://portfolio.example.com
RATE_LIMIT_PER_MINUTE=30
MAX_JSON_SIZE=32kb

# Ollama is optional. Set false to run deterministic-only.
OLLAMA_ENABLED=true
